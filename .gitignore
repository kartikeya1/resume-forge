# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local agent/editor config
.claude/

# Jobs Forge snapshots hold real job-search data (companies, recruiters,
# rejections) and this repo is public. The dashboard reads the file from disk
# via the File System Access API - it is never meant to be committed.
*jobs-forge-snapshot*.json
jobs-forge-snapshot*.json
